# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and nested apps)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
.nyc_output/

# next.js (storefront and admin)
.next/
out/

# production output
build/
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.p12
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# deployment/local tooling
.vercel/
.netlify/
.turbo/

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data and local database exports
uploads/
backend/uploads/
*.pid
*.seed
*.sqlite
*.sqlite3
*.db
dump/
backups/

# archives and temporary files
*.zip
*.tar
*.tar.gz
*.tmp
*.temp
.cache/
